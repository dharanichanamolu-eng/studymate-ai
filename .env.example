# Copy to .env and edit. NEVER commit .env.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_SSL=false
FALKORDB_GRAPH=studymate

# Default student ID shown in the sidebar
STUDENT_ID=student-1

# Optional: enables LLM-written recommendations. Leave empty to use the rule-based fallback.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
